{
  "name": "wpistic-whatsapp-crm",
  "version": "0.1.0",
  "private": true,
  "description": "WPistic WhatsApp CRM — multi-tenant WhatsApp CRM SaaS built on Next.js and Supabase, with dual-provider messaging (Meta Cloud API + Twilio), org-scoped tenancy, and Memberistic/Licenseistic SSO gating.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "WPistic",
  "homepage": "https://github.com/shubochandrosarker/WPistic-WhatsApp-CRM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubochandrosarker/WPistic-WhatsApp-CRM.git"
  },
  "bugs": {
    "url": "https://github.com/shubochandrosarker/WPistic-WhatsApp-CRM/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "twilio",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "multi-tenant",
    "saas"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.103.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.9"
  }
}

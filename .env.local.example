# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://wxlxdtzosgcwldezcfai.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind4bHhkdHpvc2djd2xkZXpjZmFpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNzA4NTUsImV4cCI6MjA5NDg0Njg1NX0.3IXTHFNSO1_vsXJ2KulYKlL2LO5gZDaft484duXCwZ8

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook and automation engine). Keep this secret —
# never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap, OG images, and any email the app
# sends. Defaults to https://wpistic.com if unset.
NEXT_PUBLIC_SITE_URL=https://app.chatbotistic.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ============================================================
# CLOUDFLARE WORKERS AI — RAG chatbot ("AI Reply" automation step).
# ============================================================
# Powers the knowledge-base chatbot: embeddings + chat completions
# run on Cloudflare Workers AI. Required only if you use the AI Reply
# step or the Knowledge Base page.
#
# Account ID: Cloudflare dashboard → any domain → right sidebar, or
#   the URL: dash.cloudflare.com/<account-id>
# API token: dashboard → My Profile → API Tokens → Create Token,
#   with the "Workers AI" permission (Account → Workers AI → Read).
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-api-token

# Optional model overrides. Defaults shown; the embedding model MUST
# output 768-dim vectors to match the ai_knowledge_base schema.
# CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# CLOUDFLARE_AI_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct

# ============================================================
# CHATBOTISTIC WHITE-LABEL — chatbot leads sync.
# ============================================================
# Powers the Leads page: pulls leads captured by your Chatbotistic
# bots via GET /api/get-json-lead. The key is sent as the raw
# Authorization header value and never reaches the browser.
# Find the key in your Chatbotistic dashboard (API / integrations).
#
# This is the PLATFORM-WIDE fallback key. Each org can save its own
# leads key in Settings → Chatbotistic (encrypted per org) — when set,
# that key is used instead, so the org sees only its own leads.
# CHATBOTISTIC_API_KEY=your-chatbotistic-api-key

# Optional — override the API base URL. Defaults to the white-label API.
# CHATBOTISTIC_API_URL=https://services.tochat.be

# ============================================================
# TOCHAT WHITE-LABEL API — full widget/agent/booking/campaign API.
# ============================================================
# A different, separate integration from the leads sync above: this is
# the JWT-authenticated API (src/lib/tochat/client.ts) behind the
# Widget Studio (widgets, agents, FAQs, bookings, campaigns,
# audiences, banners, payment links).
#
# These credentials are the SHARED MASTER fallback, used only by orgs
# that have NOT connected their own account in Settings → Chatbotistic
# (every such org's queries are scoped by its `userClient` tag — see
# migration 020 and src/lib/tochat/org-config.ts). Orgs with their own
# connected account run entirely inside it (perfect data isolation).
# Set these directly in your hosting platform's secret store; never
# commit real values here.
# TOCHAT_API_EMAIL=your-master-account-email
# TOCHAT_API_PASSWORD=your-master-account-password

# Optional — override the API base URL. Defaults to our white-label.
# TOCHAT_API_BASE=https://services.tochat.be
# Optional comma-separated allowlist for approved Tochat API hosts.
# TOCHAT_API_ALLOWED_HOSTS=services.tochat.be

# ============================================================
# MESSAGING PROVIDER — multi-provider messaging layer.
# ============================================================
# Each org picks its provider in Settings → WhatsApp ("meta",
# "twilio", or "jasmin" for a self-hosted SMS gateway) and stores its
# own credentials, encrypted at rest. The values below are only
# fallback defaults / shared verification.

# Twilio webhook validation. When an org uses the Twilio provider,
# inbound webhooks are signed by Twilio with X-Twilio-Signature; the
# webhook validates them against the org's auth token. This optional
# global token is a fallback when an org has no token on file.
# TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Self-hosted SMS gateway (Jasmin) webhook secret. Jasmin cannot sign
# its callbacks, so /api/sms/webhook authenticates inbound (MO) and
# delivery-receipt (DLR) requests with this shared secret passed as
# ?token=. Required for the "jasmin" provider — the webhook rejects
# every request when it is unset.
#   openssl rand -hex 32
# SMS_WEBHOOK_SECRET=generate-a-long-random-string

# ============================================================
# SSO BRIDGE — Memberistic + Licenseistic gating (WordPress side).
# ============================================================
# WPistic CRM trusts a signed SSO token minted by the WordPress
# plugins. Memberistic asserts the membership/plan; Licenseistic
# asserts the license key, allowed domains, and widget/agent limits.

# Shared HMAC secret used to verify inbound SSO tokens. Must match the
# secret configured in the Memberistic/Licenseistic WordPress plugins.
#   openssl rand -hex 32
# SSO_SHARED_SECRET=generate-a-long-random-string

# Base URL of the WordPress site hosting Memberistic + Licenseistic.
# Used for the license/entitlement verification callback.
# WORDPRESS_SSO_URL=https://your-wordpress-site.com

# Max clock skew (seconds) tolerated on SSO token timestamps.
# SSO_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------
# IN-DASHBOARD HELP BUBBLE.
#
# The floating assistant on every signed-in dashboard page, backed by
# the WPISTIC AI worker. Both values are baked in at build time, so
# changing either needs a rebuild — not just a restart.
#
# See docs/support-bubble.md. Note the bubble cannot reach the worker
# until the dashboard origin is added to the worker's CORS allowlist.
# ---------------------------------------------------------------

# Worker origin. Defaults to https://chat.wpistic.cloud when unset.
# NEXT_PUBLIC_SUPPORT_CHAT_URL=https://chat.wpistic.cloud

# Set to 0 to hide the bubble entirely.
# NEXT_PUBLIC_SUPPORT_BUBBLE=0
